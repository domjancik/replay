diff --git a/cmd/rmctl/commands/account/cmd_test.go b/cmd/rmctl/commands/account/cmd_test.go
index 5b6abd0..5a4223f 100644
--- a/cmd/rmctl/commands/account/cmd_test.go
+++ b/cmd/rmctl/commands/account/cmd_test.go
@@ -9,0 +10 @@
+	"fmt"
@@ -49,0 +51,29 @@ func TestCommands(t *testing.T) {
+func TestRegisterCodeFromStdin(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name, input string
+		args        []string
+		valid       bool
+	}{
+		{"valid", "abcdefgh\n", []string{"register", "--code-stdin"}, true},
+		{"valid-crlf", "abcdefgh\r\n", []string{"register", "--code-stdin"}, true},
+		{"invalid", "secret-invalid\n", []string{"register", "--code-stdin"}, false},
+		{"trailing-input", "abcdefgh\nextra\n", []string{"register", "--code-stdin"}, false},
+		{"conflicting-argument", "abcdefgh\n", []string{"register", "--code-stdin", "x"}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := &clitest.Fake{}
+			r := clitest.Exec(t, f.Services(), clitest.Options{Stdin: tc.input}, Commands, tc.args...)
+			if tc.valid {
+				if r.Code != 0 || r.Out != "registered\n" || strings.Join(f.Calls(), ",") != "Register abcdefgh" {
+					t.Fatalf("code %d out %q calls %v", r.Code, r.Out, f.Calls())
+				}
+				return
+			}
+			if r.Code != cliutil.CodeUsage || len(f.Calls()) != 0 || strings.Contains(fmt.Sprint(r.Error), tc.input) {
+				t.Fatalf("code %d calls %v err %v", r.Code, f.Calls(), r.Error)
+			}
+		})
+	}
+}
