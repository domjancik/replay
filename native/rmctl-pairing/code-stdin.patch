diff --git a/cmd/rmctl/e2e_integration_test.go b/cmd/rmctl/e2e_integration_test.go
index ffbc317..5453594 100644
--- a/cmd/rmctl/e2e_integration_test.go
+++ b/cmd/rmctl/e2e_integration_test.go
@@ -127,0 +128,34 @@ func TestE2E_RegisterAndAccount(t *testing.T) {
+func TestE2E_StdinRegistrationSharesProfile(t *testing.T) {
+	e := newE2E(t)
+	t.Setenv("RMCTL_PROFILE", "rm-redraw")
+	readCode, writeCode, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer readCode.Close()
+	if _, err = writeCode.WriteString(clouddouble.ValidCode + "\n"); err != nil {
+		writeCode.Close()
+		t.Fatal(err)
+	}
+	if err = writeCode.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var out, errOut bytes.Buffer
+	flags := []string{"--offline=false", "--no-cache", "--json"}
+	register := append(slices.Clone(flags), "register", "--code-stdin")
+	exit := runWith(register, readCode, &out, &errOut, func(c int) {
+		t.Fatalf("unexpected exit %d", c)
+	}, seams{}, e.cloud.Options()...)
+	if exit != 0 {
+		t.Fatalf("register exit %d: %s", exit, errOut.String())
+	}
+	e.ok(append(slices.Clone(flags), "find")...)
+	e.ok(append(slices.Clone(flags), "logout", "--revoke")...)
+	if e.cloud.Revoked() != 1 {
+		t.Fatalf("revoked %d times", e.cloud.Revoked())
+	}
+	if code, _, _ := e.rmctl(append(slices.Clone(flags), "find")...); code != 3 {
+		t.Fatalf("after logout: exit %d", code)
+	}
+}
